# Paste into Dokploy -> your Compose app -> Environment, then replace the values.
# See docs/DOKPLOY.md.

# --- Auth ---
# Generate one: python -c "import secrets; print(secrets.token_urlsafe(50))"
SECRET_KEY=replace-with-a-long-random-string
ALGORITHM=HS256

# --- LLM ---
GEMINI_API_KEY=replace-with-your-gemini-api-key
# GEMINI_MODEL=gemini-2.5-flash

# --- Database (Postgres container in the same stack) ---
POSTGRES_USER=jobprep
POSTGRES_DB=jobprep
# It goes into a connection URL, so use only letters, digits, - and _:
#   python -c "import secrets; print(secrets.token_urlsafe(32))"
POSTGRES_PASSWORD=replace-with-a-strong-password
# Postgres keeps the password from the deploy that first created its volume. Got
# "password authentication failed" after changing it and there are no real users yet?
# Raise this by one to start a fresh, empty database. Never raise it once there are users.
# DB_VOLUME_VERSION=1

# --- CORS ---
# The browser calls the API on the same origin (/api), so this only matters if another
# site calls the API directly.
CORS_ORIGINS=https://job-prep-ai.ankit-poudel.com.np

# --- Celery ---
# CELERY_CONCURRENCY=2
